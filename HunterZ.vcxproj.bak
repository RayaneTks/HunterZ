    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <!-- ============ DEBUG COMPILE ============ -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;DbgHelp.lib;Psapi.lib;winhttp.lib;BlackBone.lib;FW1FontWrapperRel.lib;freetype.lib;libMinHook.lib;libprotobuf.lib;BeaEngine64.lib;diaguids.lib;dwrite.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ============ RELEASE COMPILE (stealth) ============ -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level2</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>false</SDLCheck>
      <!-- RELEASE_BUILD dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©fini ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ active XorStr, dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©sactive logs debug -->
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;RELEASE_BUILD;DISABLE_PROTOBUF=1;DISABLE_INVENTORY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- /MT = static runtime, pas de dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©pendance MSVCRT visible -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <!-- DÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©sactive RTTI ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©duit mÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©tadonnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©es type visible -->
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <ExceptionHandling>Sync</ExceptionHandling>
      <!-- /GS- = pas de stack canary check ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ moins de code de sÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©curitÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© injectable -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <AdditionalOptions>/bigobj /Gy %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Pas de PDB en Release ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ aucun symbol exposÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© -->
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <!-- Pas de manifest intÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©grÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ moins de metadata PE -->
      <GenerateManifest>false</GenerateManifest>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;DbgHelp.lib;Psapi.lib;winhttp.lib;BlackBone.lib;FW1FontWrapperRel.lib;freetype.lib;libMinHook.lib;libprotobuf.lib;BeaEngine64.lib;diaguids.lib;dwrite.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Supprime les exports inutiles -->
      <AdditionalOptions>/NOEXP /NOIMPLIB %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <!-- Post-build: supprimer le .exp et .lib gÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©nÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©s (pas nÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©cessaires pour DLL cheat) -->
    <PostBuildEvent>
      <Command>if exist "$(OutDir)$(TargetName).exp" del /f "$(OutDir)$(TargetName).exp"
if exist "$(OutDir)$(TargetName).lib" del /f "$(OutDir)$(TargetName).lib"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

