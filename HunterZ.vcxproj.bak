            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />

  <!-- ============ INCLUDE PATHS ============ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>HunterZ_d</TargetName>
    <OutDir>$(ProjectDir)bin\Debug\</OutDir>
    <IntDir>$(ProjectDir)obj\Debug\</IntDir>
    <IncludePath>$(ProjectDir)include\;$(ProjectDir)src\;$(ProjectDir)src\sdk\cs2\;$(ProjectDir)src\sdk\cs2\protobuf\;$(ProjectDir)src\sdk\math\;$(ProjectDir)src\core\;$(ProjectDir)src\utils\;$(ProjectDir)src\render\;$(ProjectDir)src\hooks\;$(ProjectDir)src\features\aimbot\;$(ProjectDir)src\features\visuals\;$(ProjectDir)src\features\inventory\;$(ProjectDir)third_party\;$(ProjectDir)third_party\imgui\;$(ProjectDir)third_party\minhook\include\;$(ProjectDir)third_party\rapidjson\include\;$(ProjectDir)config\;$(ProjectDir)offsets\;$(ProjectDir)third_party\imgui\freetype\;$(ProjectDir)src\sdk\cs2\;$(IncludePath)</IncludePath>
    <LibraryPath>$(ProjectDir)lib\x64\;$(LibraryPath)</LibraryPath>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>HunterZ</TargetName>
    <OutDir>$(ProjectDir)bin\Release\</OutDir>
    <IntDir>$(ProjectDir)obj\Release\</IntDir>
    <IncludePath>$(ProjectDir)include\;$(ProjectDir)src\;$(ProjectDir)src\sdk\cs2\;$(ProjectDir)src\sdk\cs2\protobuf\;$(ProjectDir)src\sdk\math\;$(ProjectDir)src\core\;$(ProjectDir)src\utils\;$(ProjectDir)src\render\;$(ProjectDir)src\hooks\;$(ProjectDir)src\features\aimbot\;$(ProjectDir)src\features\visuals\;$(ProjectDir)src\features\inventory\;$(ProjectDir)third_party\;$(ProjectDir)third_party\imgui\;$(ProjectDir)third_party\minhook\include\;$(ProjectDir)third_party\rapidjson\include\;$(ProjectDir)config\;$(ProjectDir)offsets\;$(ProjectDir)third_party\imgui\freetype\;$(ProjectDir)src\sdk\cs2\;$(IncludePath)</IncludePath>
